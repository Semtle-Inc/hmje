# app_syscall_runtime_llvm
함수 앱텍스트시스템호출런타임은 (소비하는 줄들: 문자열의 배열)를 받아
    줄들에 ""를 추가한다.
    줄들에 "define void @_start() noredzone {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  %result = call i32 @main()"를 추가한다.
    줄들에 "  %code = sext i32 %result to i64"를 추가한다.
    줄들에 "  %ignored = call i64 @hmje_arch_syscall1(i64 0, i64 %code)"를 추가한다.
    줄들에 "  br label %halt"를 추가한다.
    줄들에 "halt:"를 추가한다.
    줄들에 "  call void asm sideeffect \"pause\", \"~{memory}\"()"를 추가한다.
    줄들에 "  br label %halt"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define i64 @hmje_arch_syscall0(i64 %number) naked noinline nounwind {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  call void asm sideeffect \"movq %rdi, %rax\\0A\\09xorq %rdi, %rdi\\0A\\09xorq %rsi, %rsi\\0A\\09xorq %rdx, %rdx\\0A\\09xorq %r10, %r10\\0A\\09xorq %r8, %r8\\0A\\09xorq %r9, %r9\\0A\\09syscall\\0A\\09retq\", \"~{rax},~{rdi},~{rsi},~{rdx},~{r8},~{r9},~{r10},~{rcx},~{r11},~{memory}\"()"를 추가한다.
    줄들에 "  unreachable"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define i64 @hmje_arch_syscall1(i64 %number, i64 %arg1) naked noinline nounwind {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  call void asm sideeffect \"movq %rdi, %rax\\0A\\09movq %rsi, %rdi\\0A\\09xorq %rsi, %rsi\\0A\\09xorq %rdx, %rdx\\0A\\09xorq %r10, %r10\\0A\\09xorq %r8, %r8\\0A\\09xorq %r9, %r9\\0A\\09syscall\\0A\\09retq\", \"~{rax},~{rdi},~{rsi},~{rdx},~{r8},~{r9},~{r10},~{rcx},~{r11},~{memory}\"()"를 추가한다.
    줄들에 "  unreachable"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define i64 @hmje_arch_syscall3(i64 %number, i64 %arg1, i64 %arg2, i64 %arg3) naked noinline nounwind {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  call void asm sideeffect \"movq %rdi, %rax\\0A\\09movq %rsi, %rdi\\0A\\09movq %rdx, %rsi\\0A\\09movq %rcx, %rdx\\0A\\09xorq %r10, %r10\\0A\\09xorq %r8, %r8\\0A\\09xorq %r9, %r9\\0A\\09syscall\\0A\\09retq\", \"~{rax},~{rdi},~{rsi},~{rdx},~{r8},~{r9},~{r10},~{rcx},~{r11},~{memory}\"()"를 추가한다.
    줄들에 "  unreachable"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define i64 @hmje_arch_syscall6(i64 %number, i64 %arg1, i64 %arg2, i64 %arg3, i64 %arg4, i64 %arg5, i64 %arg6) naked noinline nounwind {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  call void asm sideeffect \"movq %rdi, %rax\\0A\\09movq %r8, %r10\\0A\\09movq %r9, %r8\\0A\\09movq 8(%rsp), %r9\\0A\\09movq %rsi, %rdi\\0A\\09movq %rdx, %rsi\\0A\\09movq %rcx, %rdx\\0A\\09syscall\\0A\\09retq\", \"~{rax},~{rdi},~{rsi},~{rdx},~{rcx},~{r8},~{r9},~{r10},~{r11},~{memory}\"()"를 추가한다.
    줄들에 "  unreachable"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들을 문자열의 배열로 반환한다.

# x86_64_app_thread_runtime_llvm
