# aarch64_freestanding_memlib_llvm
함수 aarch64텍스트메모리라이브러리은 (소비하는 줄들: 문자열의 배열)를 받아
    줄들에 ""를 추가한다.
    줄들에 "define ptr @memset(ptr %dest, i32 %val, i64 %len) noinline optnone {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  %v8 = trunc i32 %val to i8"를 추가한다.
    줄들에 "  br label %cond"를 추가한다.
    줄들에 "cond:"를 추가한다.
    줄들에 "  %i = phi i64 [ 0, %entry ], [ %inext, %body ]"를 추가한다.
    줄들에 "  %c = icmp ult i64 %i, %len"를 추가한다.
    줄들에 "  br i1 %c, label %body, label %done"를 추가한다.
    줄들에 "body:"를 추가한다.
    줄들에 "  %p = getelementptr i8, ptr %dest, i64 %i"를 추가한다.
    줄들에 "  store i8 %v8, ptr %p"를 추가한다.
    줄들에 "  %inext = add i64 %i, 1"를 추가한다.
    줄들에 "  br label %cond"를 추가한다.
    줄들에 "done:"를 추가한다.
    줄들에 "  ret ptr %dest"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define ptr @memcpy(ptr %dest, ptr %src, i64 %len) noinline optnone {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  br label %cond"를 추가한다.
    줄들에 "cond:"를 추가한다.
    줄들에 "  %i = phi i64 [ 0, %entry ], [ %inext, %body ]"를 추가한다.
    줄들에 "  %c = icmp ult i64 %i, %len"를 추가한다.
    줄들에 "  br i1 %c, label %body, label %done"를 추가한다.
    줄들에 "body:"를 추가한다.
    줄들에 "  %sp = getelementptr i8, ptr %src, i64 %i"를 추가한다.
    줄들에 "  %b = load i8, ptr %sp"를 추가한다.
    줄들에 "  %dp = getelementptr i8, ptr %dest, i64 %i"를 추가한다.
    줄들에 "  store i8 %b, ptr %dp"를 추가한다.
    줄들에 "  %inext = add i64 %i, 1"를 추가한다.
    줄들에 "  br label %cond"를 추가한다.
    줄들에 "done:"를 추가한다.
    줄들에 "  ret ptr %dest"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들에 ""를 추가한다.
    줄들에 "define ptr @memmove(ptr %dest, ptr %src, i64 %len) noinline optnone {"를 추가한다.
    줄들에 "entry:"를 추가한다.
    줄들에 "  %d = ptrtoint ptr %dest to i64"를 추가한다.
    줄들에 "  %s = ptrtoint ptr %src to i64"를 추가한다.
    줄들에 "  %fwd = icmp ule i64 %d, %s"를 추가한다.
    줄들에 "  br i1 %fwd, label %fcond, label %bentry"를 추가한다.
    줄들에 "fcond:"를 추가한다.
    줄들에 "  %fi = phi i64 [ 0, %entry ], [ %finext, %fbody ]"를 추가한다.
    줄들에 "  %fc = icmp ult i64 %fi, %len"를 추가한다.
    줄들에 "  br i1 %fc, label %fbody, label %done"를 추가한다.
    줄들에 "fbody:"를 추가한다.
    줄들에 "  %fsp = getelementptr i8, ptr %src, i64 %fi"를 추가한다.
    줄들에 "  %fb = load i8, ptr %fsp"를 추가한다.
    줄들에 "  %fdp = getelementptr i8, ptr %dest, i64 %fi"를 추가한다.
    줄들에 "  store i8 %fb, ptr %fdp"를 추가한다.
    줄들에 "  %finext = add i64 %fi, 1"를 추가한다.
    줄들에 "  br label %fcond"를 추가한다.
    줄들에 "bentry:"를 추가한다.
    줄들에 "  br label %bcond"를 추가한다.
    줄들에 "bcond:"를 추가한다.
    줄들에 "  %bi = phi i64 [ %len, %bentry ], [ %binext, %bbody ]"를 추가한다.
    줄들에 "  %bc = icmp ugt i64 %bi, 0"를 추가한다.
    줄들에 "  br i1 %bc, label %bbody, label %done"를 추가한다.
    줄들에 "bbody:"를 추가한다.
    줄들에 "  %binext = sub i64 %bi, 1"를 추가한다.
    줄들에 "  %bsp = getelementptr i8, ptr %src, i64 %binext"를 추가한다.
    줄들에 "  %bb = load i8, ptr %bsp"를 추가한다.
    줄들에 "  %bdp = getelementptr i8, ptr %dest, i64 %binext"를 추가한다.
    줄들에 "  store i8 %bb, ptr %bdp"를 추가한다.
    줄들에 "  br label %bcond"를 추가한다.
    줄들에 "done:"를 추가한다.
    줄들에 "  ret ptr %dest"를 추가한다.
    줄들에 "}"를 추가한다.
    줄들을 문자열의 배열로 반환한다.
