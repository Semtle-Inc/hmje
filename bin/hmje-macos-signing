#!/bin/sh

# Owned scratch survives only when explicitly requested for debugging.
hmje_temp_remove() {
    if [ "${HMJE_KEEP_TEMP:-0}" = 1 ]; then
        for hmje_temp_path do
            [ "$hmje_temp_path" = -- ] || [ -z "$hmje_temp_path" ] || printf 'HMJE_KEEP_TEMP=1: %s\n' "$hmje_temp_path" >&2
        done
    else
        rm -rf "$@"
    fi
}
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for SIGNING_TOOL in "${HMJE_TOOL_BIN:-${HMJE_BOOTSTRAP_BIN:-}}/hmje-macos-signing" "$ROOT/libexec/bin/hmje-macos-signing"; do
    if [ -x "$SIGNING_TOOL" ]; then exec "$SIGNING_TOOL" "$@"; fi
done
# Source checkouts can use the native helper without a global installation.
[ -f "$ROOT/tools/macos-signing.m" ] || { echo 'macOS 서명 도구가 없습니다. 툴체인을 업데이트하세요.' >&2; exit 2; }
SIGNING_WORK=$(mktemp -d "${TMPDIR:-/tmp}/hmje-macos-signing.XXXXXXXX")
trap 'hmje_temp_remove "$SIGNING_WORK"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
/usr/bin/clang -fobjc-arc -O2 -framework Foundation "$ROOT/tools/macos-signing.m" -o "$SIGNING_WORK/helper"
"$SIGNING_WORK/helper" "$@"
